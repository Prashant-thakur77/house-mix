# Copy to .env.local (gitignored). Never commit real values.
ANTHROPIC_API_KEY=
QLOO_API_KEY=
SETLISTFM_API_KEY=
# mock | live
QLOO_MODE=mock
# Claude model IDs (one place to change them)
HM_MODEL=claude-sonnet-5-5
HM_PLANNER_MODEL=claude-sonnet-5-5
# Store: file | firestore
HM_STORE=file
GOOGLE_CLOUD_PROJECT=
HM_AUDIO_BUCKET=
# Web -> API base URL (public, not a secret)
NEXT_PUBLIC_API_URL=http://localhost:8787
