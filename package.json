{
  "name": "house-mix",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "eval"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @housemix/api",
    "dev:web": "npm run dev -w @housemix/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "qloo:verify": "tsx --env-file-if-exists=.env.local scripts/qloo-verify.ts",
    "ui:research": "tsx scripts/ui-research.ts",
    "eval:fetch": "npm run fetch -w @housemix/eval",
    "eval:backtest": "npm run backtest -w @housemix/eval",
    "eval:ab:pairs": "npm run ab:pairs -w @housemix/eval",
    "eval:ab:score": "npm run ab:score -w @housemix/eval",
    "eval:ab:judge": "npm run ab:judge -w @housemix/eval",
    "eval:evidence": "npm run evidence -w @housemix/eval",
    "eval:qloo": "npm run qloo:value -w @housemix/eval",
    "eval:report": "npm run report -w @housemix/eval",
    "eval:all": "npm run all -w @housemix/eval"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
