{
  "name": "house-mix",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "eval"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @housemix/api",
    "dev:web": "npm run dev -w @housemix/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "qloo:verify": "tsx --env-file-if-exists=.env.local scripts/qloo-verify.ts",
    "ui:research": "tsx scripts/ui-research.ts"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "@types/node": "^22.20.5"
  }
}
